FROM arm64v8/python:3.12-alpine

ENV PYTHONUNBUFFERED=1
ENV C_FORCE_ROOT=1

WORKDIR /code

# Install build and runtime dependencies
RUN apk add --no-cache \
    git \
    cmake \
    libffi-dev \
    linux-headers \
    g++ \
    ffmpeg \
    bash \
    curl \
    gcc \
    musl-dev \
    python3-dev \
    make \
    tini

# Install Python dependencies
COPY ./src/requirements.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install "Cython<3.0" pyyaml --no-build-isolation && \
    pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Create a more robust health check script that includes Redis auth
RUN echo '#!/bin/bash\n\
cd /code\n\
if [ -z "${REDIS_PASSWORD}" ]; then\n\
    echo "REDIS_PASSWORD is not set"\n\
    exit 1\n\
fi\n\
celery -A celery_worker.celery inspect ping -d "worker@$HOSTNAME" \\\n\
    --broker="redis://:${REDIS_PASSWORD}@redisARM:6379/0" 2>&1 || exit 1\n\
if [ $? -eq 0 ]; then\n\
    echo "Celery worker is healthy"\n\
    exit 0\n\
else\n\
    echo "Celery worker is unhealthy"\n\
    exit 1\n\
fi' > /usr/local/bin/celery-healthcheck.sh && \
    chmod +x /usr/local/bin/celery-healthcheck.sh

COPY ./src/. /code

# Use tini as init system
ENTRYPOINT ["/sbin/tini", "--"]

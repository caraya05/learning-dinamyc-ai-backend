FROM arm64v8/python:3.10-alpine AS builder

ENV PYTHONUNBUFFERED=1
ENV C_FORCE_ROOT=1

# Install build dependencies
RUN apk add --no-cache gdal libpq-dev git cmake gettext libffi-dev gcc g++ musl-dev linux-headers

# Install Python dependencies
COPY ./src/requirements.txt /code/requirements.txt
RUN pip install "Cython<3.0" pyyaml --no-build-isolation \
    && pip install --no-cache-dir --upgrade -r /code/requirements.txt

# Stage 2: Final
FROM arm64v8/python:3.10-alpine

ENV PYTHONUNBUFFERED=1
ENV C_FORCE_ROOT=1

# Install runtime dependencies
RUN apk add --no-cache gdal libpq-dev git cmake gettext libffi-dev figlet ffmpeg

WORKDIR /code

# Copy installed Python packages from builder stage
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY ./src/. /code